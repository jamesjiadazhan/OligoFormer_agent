    "output_contract": {
      "files_per_record": [
        "<output_dir><record>.txt",
        "<output_dir><record>_ranked.txt",
        "<output_dir><record>_ranked_filtered.txt"
      ],
      "columns": [
        "pos",
        "sense",
        "siRNA",
        "efficacy",
        "func_filter",
        "filter"
      ],
      "format": "tab-separated, header, no index; record name = FASTA header with ' ' -> '_@_'",
      "pos_semantics": "ROW COUNTER (1..n over the siRNAs matched in that record, in siRNA-FASTA order), NOT the genomic/window position. Verified in changed_input: RNA0 window i=36 siRNA gets pos 1, window i=25 gets pos 2; RNA1 window i=31 -> pos 1, i=3 -> pos 2.",
      "sense": "antiRNA(siRNA) = the matched 19-nt mRNA window (5'->3')",
      "matching": "per record, re.search(antiRNA(siRNA), mRNA); first occurrence only; siRNAs that match nowhere are silently dropped (no warning, no row)",
